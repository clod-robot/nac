<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nac.log.mapper.SysUserBriefMapper">

    <resultMap id="userBriefMap" type="com.nac.log.entity.SysUserBrief">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="realName" column="real_name"/>
        <result property="dept" column="dept"/>
        <result property="roleCode" column="role_code"/>
        <result property="status" column="status"/>
        <result property="phoneBlind" column="phone_blind"/>
    </resultMap>

    <!-- 显式列名，禁止 SELECT *；仅返回溯源所需最小字段，密文不返回 -->
    <select id="selectByUsername" resultMap="userBriefMap">
        SELECT id, username, real_name, dept, role_code, status, phone_blind
        FROM sys_user
        WHERE username = #{username}
        LIMIT 1
    </select>

    <select id="selectByPhone" resultMap="userBriefMap">
        SELECT id, username, real_name, dept, role_code, status, phone_blind
        FROM sys_user
        WHERE phone_blind = #{phone}
        LIMIT 1
    </select>

</mapper>
