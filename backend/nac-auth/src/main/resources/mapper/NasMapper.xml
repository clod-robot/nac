<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nac.auth.mapper.NasMapper">

    <resultMap id="n" type="com.nac.auth.entity.NasDevice">
        <id property="id" column="id"/>
        <result property="nasIp" column="nas_ip"/>
        <result property="nasName" column="nas_name"/>
        <result property="nasIdentifier" column="nas_identifier"/>
        <result property="lastUser" column="last_user"/>
        <result property="successCount" column="success_count"/>
        <result property="failCount" column="fail_count"/>
        <result property="lastSeen" column="last_seen"/>
        <result property="createTime" column="create_time"/>
        <result property="online" column="online"/>
    </resultMap>

    <select id="list" resultMap="n">
        SELECT n.id, n.nas_ip, n.nas_name, n.nas_identifier, n.last_user, n.success_count, n.fail_count,
               n.last_seen, n.create_time,
               EXISTS(SELECT 1 FROM sys_online_session o WHERE o.nas_ip = n.nas_ip AND o.status = 1) AS online
        FROM sys_nas n
        ORDER BY n.last_seen DESC
        LIMIT 200
    </select>

    <update id="updateName">
        UPDATE sys_nas SET nas_name = #{nasName} WHERE nas_ip = #{nasIp}
    </update>
</mapper>
