  "rules": [
    {
      "id": "CVE-2016-6210", "product": "OpenSSH", "severity": "medium",
      "service": "ssh", "source": "banner",
      "regex": "OpenSSH[_ -]?v?([0-9]+\\.[0-9]+)", "versionGroup": 1,
      "op": "lt", "version": "7.0",
      "title": "OpenSSH 用户名枚举",
      "description": "7.0 之前版本在处理不存在用户时存在计时差异，可枚举有效用户名用于后续口令攻击。",
      "solution": "升级 OpenSSH 到 7.0 以上版本。",
      "reference": "https://www.openssh.com/security.html"
    },
    {
      "id": "CVE-2016-10009", "product": "OpenSSH", "severity": "medium",
      "service": "ssh", "source": "banner",
      "regex": "OpenSSH[_ -]?v?([0-9]+\\.[0-9]+)", "versionGroup": 1,
      "op": "lt", "version": "7.2",
      "title": "OpenSSH agent 转发/特权分离系列漏洞",
      "description": "7.2 之前版本存在 CVE-2016-10009/10011/10012，可导致本地提权或在特定配置下执行代码。",
      "solution": "升级 OpenSSH 到 7.2 以上版本。",
      "reference": "https://www.openssh.com/security.html"
    },
    {
      "id": "VS-SSHV1", "product": "OpenSSH/设备SSH", "severity": "high",
      "service": "ssh", "source": "banner", "regex": "SSH-1\\.99",
      "op": "any",
      "title": "SSH 服务支持 SSHv1 协议",
      "description": "SSH-1.99 标识表示服务端兼容 SSHv1，v1 协议存在已知加密弱点。",
      "solution": "禁用协议版本 1，仅允许 SSHv2。"
    },
    {
      "id": "VS-DROPBEAR-OLD", "product": "Dropbear SSH", "severity": "medium",
      "service": "ssh", "source": "banner",
      "regex": "dropbear[_ ]?v?([0-9]{4}\\.[0-9]+)", "versionGroup": 1,
      "op": "lt", "version": "2016.74",
      "title": "Dropbear 版本过旧",
      "description": "2016.74 之前的 Dropbear 存在 X11 转发命令注入等历史漏洞，嵌入式/网络设备常见。",
      "solution": "升级 Dropbear 或升级设备固件。"
    },
    {
      "id": "VS-VSFTPD-234", "product": "vsftpd", "severity": "critical",
      "service": "ftp", "source": "banner",
      "regex": "vsftpd\\.?\\(?v?(2\\.3\\.4)\\)?", "versionGroup": 1,
      "op": "eq", "version": "2.3.4",
      "title": "vsftpd 2.3.4 后门版本",
      "description": "2.3.4 曾被植入后门，特定用户名登录后在 6200 端口开放 root shell。",
      "solution": "立即更换为官方最新版 vsftpd，检查主机是否已被入侵。"
    },
    {
      "id": "VS-PROFTPD-133C", "product": "ProFTPD", "severity": "critical",
      "service": "ftp", "source": "banner",
      "regex": "ProFTPD\\s+(1\\.3\\.3c)", "versionGroup": 1,
      "op": "eq", "version": "1.3.3c",
      "title": "ProFTPD 1.3.3c 后门版本",
      "description": "1.3.3c 曾被篡改植入后门，-c 版本可被特殊命令直接获取 root shell。",
      "solution": "从官方源重新安装受支持版本，排查入侵痕迹。"
    },
    {
      "id": "CVE-2015-3306", "product": "ProFTPD", "severity": "high",
      "service": "ftp", "source": "banner",
      "regex": "ProFTPD\\s+(1\\.3\\.5)", "versionGroup": 1,
      "op": "eq", "version": "1.3.5",
      "title": "ProFTPD mod_copy 未授权复制(RCE)",
      "description": "1.3.5 版本 mod_copy 的 SITE CPFR/CPTO 命令无需认证，可向 Web 目录写入文件导致 RCE（1.3.5b 修复，建议人工验证补丁小版本）。",
      "solution": "升级 ProFTPD 至 1.3.5b/1.3.6 以上，或禁用 mod_copy。"
    },
